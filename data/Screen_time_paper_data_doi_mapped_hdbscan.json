  "10.1002/ped4.70086": [
    {
      "text": "The increasing integration of artificial intelligence (AI) into children's daily environments challenges traditional approaches to evaluating digital exposure. This narrative review aims to synthesize current evidence on digital media use and emerging evidence on AI-based interaction to propose a novel framework distinguishing AI engagement from traditional screen exposure. Based on these findings, a spectrum model of digital exposure is proposed, illustrating a trade-off between increasing cognitive stimulation and decreasing opportunities for authentic social development across passive, interactive, and AI-based media.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "Although existing research has primarily focused on screen time, AI-based interactions introduce qualitatively different dynamics that remain insufficiently conceptualized.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "Findings indicate that traditional screen exposure is associated with adverse outcomes in language development, attention regulation, and social interaction, although these associations are not uniform and are moderated by content and parental involvement.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "In contrast, AI-based systems provide adaptive and personalized interactions that may enhance cognitive engagement, including learning and problem-solving.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "However, these systems lack genuine emotional reciprocity and may create an illusion of social interaction.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
      "text": "These findings highlight the need to move beyond time-based metrics toward frameworks that consider interaction quality, and updated clinical and policy approaches are required to address the developmental implications of AI-integrated childhood environments.",
      "paperTitle": "Artificial intelligence interaction is not equivalent to social interaction: Rethinking artificial intelligence-mediated digital exposure in early childhood.",
      "doi": "10.1002/ped4.70086",
      "source": "Pediatric investigation",
      "yearPublished": 2026,
      "chunk_index_in_doc": 5
    }
