      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 120
    },
    {
      "text": "To explore initial relationships between variables, Pearson correlation coefficients were computed.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
