      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 8
    },
    {
      "text": "Main effects suggest sustainability over time.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
