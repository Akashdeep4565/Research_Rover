  "10.3345/cep.2026.01417": [
    {
      "text": "This narrative review synthesizes current evidence on the association between electronic media exposure and neurodevelopmental outcomes in children under 5 years of age. Excessive and unsupervised electronic media use may adversely affect multiple domains of neurodevelopment, particularly when it replaces interactive play, caregiver engagement, and healthy sleep. Further longitudinal studies incorporating objective measures of media exposure, sleep assessment, and neuroimaging are needed to strengthen current evidence and guide pediatric recommendations.",
      "paperTitle": "Electronic media exposure and neurodevelopment in children under 5 years of age: an updated evidence-based narrative review.",
      "doi": "10.3345/cep.2026.01417",
      "source": "Clinical and experimental pediatrics",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
