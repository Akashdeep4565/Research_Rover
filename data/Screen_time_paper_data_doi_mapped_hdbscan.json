  "10.1002/dev.70170": [
    {
      "text": "This scoping review examined neuroimaging evidence relating screen-based technology use to brain development in children aged 0-12 years. Most reported associations between higher screen exposure and less favorable neurodevelopmental outcomes, including reduced cortical thickness, lower gray and white matter integrity, decreased cerebellar volume, and altered connectivity in networks involved in language, attention, executive functioning, and emotional regulation. While excessive or unregulated screen exposure appears associated with less favorable developmental outcomes, targeted digital engagement may support specific cognitive functions.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "Nine studies were included.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "These neural differences were associated with poorer literacy and language skills, increased anxiety and depressive symptoms, and greater behavioral difficulties.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "Some evidence suggested positive effects from structured and interactive digital activities, particularly video gaming, which was linked to improvements in working memory, spatial awareness, fine motor performance, and increased regional brain volume.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "Findings indicate that the impact of screen-based technology is complex and may depend on the type, duration, and context of use.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
      "text": "Further longitudinal and experimental research is needed to clarify causal pathways and guide evidence-based recommendations for children's digital media use.",
      "paperTitle": "Screen Time and the Developing Brain: A Systematic Review of Neuroimaging Findings in Children Aged 0–12 Years",
      "doi": "10.1002/dev.70170",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 5
    }
