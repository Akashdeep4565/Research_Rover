      "chunk_index_in_doc": 56
    },
    {
      "text": "Prevalence estimates across 40 studies meeting systematic review inclusion criteria ranged from 15.2% to 99.7%, with higher rates in samples collected during or after the COVID-19 pandemic (Notara et al., 2021); notably, this systematic review was conducted predominantly in young adult populations, and direct extrapolation of the age-gradient finding to children and adolescents is not supported by the available evidence.",
      "paperTitle": "Physical activity, sedentary behavior, and cognitive function in children and adolescents: a scoping review of dose-response relationships, screen time interactions, and public health implications",
      "doi": "10.3389/fnbeh.2026.1848119",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 57
    },
    {
      "text": "The magnitude of cognitive benefit from meeting all three guidelines substantially exceeds that from meeting any two, and the harm from failing to meet any one is amplified when the other two are also unmet.",
      "paperTitle": "Physical activity, sedentary behavior, and cognitive function in children and adolescents: a scoping review of dose-response relationships, screen time interactions, and public health implications",
      "doi": "10.3389/fnbeh.2026.1848119",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 58
    },
    {
      "text": "Interventions that break into this cycle at any single point face these reinforcing feedback loops.",
      "paperTitle": "Physical activity, sedentary behavior, and cognitive function in children and adolescents: a scoping review of dose-response relationships, screen time interactions, and public health implications",
      "doi": "10.3389/fnbeh.2026.1848119",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 59
    },
    {
      "text": "Breaking multiple links simultaneously, the design logic of integrated movement behavior programs is more likely to produce sustained behavior change.",
      "paperTitle": "Physical activity, sedentary behavior, and cognitive function in children and adolescents: a scoping review of dose-response relationships, screen time interactions, and public health implications",
      "doi": "10.3389/fnbeh.2026.1848119",
