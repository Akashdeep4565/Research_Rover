      "chunk_index_in_doc": 114
    },
    {
      "text": "Participants completed the questionnaire independently on their digital devices smartphones, laptops, or tablets and were advised to do so in a distraction-free environment.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
