  "10.1111/bjdp.70066": [
    {
      "text": "Young children spend an increasing amount of time engaging with screens, including television viewing. Although most research has focused on the quantity of children's viewing, growing evidence suggests that the developmental effects of screen media depend on the quality and characteristics of the content. We developed the Framework for Rating and Assessing Media for Early childhood (FRAME), a multidimensional content analysis framework grounded in developmental literature that measures prosocial, antisocial and aggressive, educational, emotional, cultural, mental state talk and pacing content in children's television shows. These findings demonstrate the reliability and validity of the FRAME and its potential to advance research examining how specific features of child-directed media relate to developmental outcomes.",
      "paperTitle": "Framework for Rating and Assessing Media for Early childhood (FRAME): A multidimensional coding system for analysing children's media content.",
      "doi": "10.1111/bjdp.70066",
      "source": "The British journal of developmental psychology",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "However, there is currently no comprehensive, developmentally informed framework for systematically assessing the features of child-directed media.",
      "paperTitle": "Framework for Rating and Assessing Media for Early childhood (FRAME): A multidimensional coding system for analysing children's media content.",
      "doi": "10.1111/bjdp.70066",
      "source": "The British journal of developmental psychology",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "The FRAME was applied to older (N = 22) and contemporary (N = 10) television shows watched by preschool-aged (2-5 years) children in Aotearoa New Zealand to characterize their content.",
      "paperTitle": "Framework for Rating and Assessing Media for Early childhood (FRAME): A multidimensional coding system for analysing children's media content.",
      "doi": "10.1111/bjdp.70066",
      "source": "The British journal of developmental psychology",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "Inter-rater reliability across dimensions and coding categories was acceptable to excellent.",
      "paperTitle": "Framework for Rating and Assessing Media for Early childhood (FRAME): A multidimensional coding system for analysing children's media content.",
      "doi": "10.1111/bjdp.70066",
      "source": "The British journal of developmental psychology",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "Convergent validity was demonstrated through correlations with Common Sense Media ratings, while also highlighting the value of a comprehensive and differentiated coding framework beyond existing measures.",
      "paperTitle": "Framework for Rating and Assessing Media for Early childhood (FRAME): A multidimensional coding system for analysing children's media content.",
      "doi": "10.1111/bjdp.70066",
      "source": "The British journal of developmental psychology",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    }
  ],
  "10.1109/access.2026.3729105": [
    {
      "text": "Media screen time is linked to physical and psychosocial health outcomes in preschool children (≤5 years), but evidence largely relies on parent reports or a single device type. This study proposes the use of a novel sensor, Screen Time Tracker (STT), to perform an objective assessment of the effect of screen time on physical activity in preschool children under free-living conditions. This proof-of-concept study objectively shows that increased screen engagement is associated with lower physical activity intensity in preschool children. These findings provide useful evidence for epidemiologists, pediatricians, and behavioral scientists studying the health effects of media screen use in children.",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "Egocentric images (10-s intervals) and triaxial accelerometer data (128 Hz) were collected from 25 children aged 3-5 years using the STT device.",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "Accelerometer data were processed to estimate activity Counts Per Minute (CPM).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "A deep learning model was used to detect multiple types of active screens in images and compute Screen Counts per Minute (SCM; range, 0-6).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "On average, children exhibited lower CPM during screen interaction (1181 for SCM > 0) than during screen-free minutes (1628 for SCM = 0).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
      "text": "Among screen interaction minutes, CPM decreased progressively with increasing SCM (from 1629 at SCM = 1 to 132 at SCM = 6).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 5
    },
    {
      "text": "A multilevel negative binomial model with a log link, accounting for minutes nested within days and days nested within children, showed that higher SCM above a child's own daily mean was significantly associated with lower activity counts in a typical child on a typical day (b = -0.228, p < .001, exp[b] = 0.796).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 6
    },
    {
      "text": "Thus, for each one-count increase in SCM above a child's daily mean, expected CPM decreased by approximately 20.4%.",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 7
    },
    {
      "text": "Furthermore, higher sustained screen interaction minutes were associated with lower physical activity.",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 8
    },
    {
      "text": "Children who continuously engaged with screens for 2 minutes showed mean CPMs of 1421, while continuous engagement for 15 minutes or more had a mean CPM of 693.",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 9
    },
    {
      "text": "Multi-level analysis showed that longer SSIM bouts were associated with lower mean CPM (b = -46.677, p = .005).",
      "paperTitle": "Objective Assessment of Media Screens Effect on Physical Activity in Preschool Children.",
      "doi": "10.1109/access.2026.3729105",
      "source": "IEEE access : practical innovations, open solutions",
      "yearPublished": 2026,
      "chunk_index_in_doc": 10
    }
  ],
