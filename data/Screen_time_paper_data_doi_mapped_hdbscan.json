  "10.1016/j.dcn.2026.101824": [
    {
      "text": "The aim of this cross-sectional study was to investigate the relationship between screen time and inhibitory control and whether white matter integrity, a marker of axonal coherence, moderates this relationship in children and adolescents. Whether white matter integrity moderates the relationship between screen time and inhibitory control was analyzed. These findings indicate that white matter integrity may reflect neurocognitive resilience to screen time-related reductions in inhibitory control.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "Excessive screen time is associated with reduced inhibitory control, a core component of executive function in children and adolescents.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "However, whether neurobiological factors buffer this effect remains unclear.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "A total of 150 participants aged 7-17 years completed the Stroop Color and Word Test, which was administered to assess inhibitory control.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "The participants underwent diffusion-weighted magnetic resonance imaging to enable evaluation of white matter integrity.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
      "text": "Screen time was determined using caregiver reports.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 5
    },
    {
      "text": "White matter integrity was indexed using fractional anisotropy (FA) in eight tracts: the bilateral superior longitudinal fasciculus (SLF) I/II, SLF III, arcuate fasciculus, and cingulum bundle.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 6
    },
    {
      "text": "Longer screen times were associated with weaker inhibitory control.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 7
    },
    {
      "text": "FA in the right SLF I/II, SLF III, and arcuate fasciculus was inversely related to screen time.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 8
    },
    {
      "text": "The right SLF I/II significantly moderated the relationship between screen time and inhibitory control.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 9
    },
    {
      "text": "The effect of increasing screen time on reducing inhibitory control was observed only at lower FA levels.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 10
    },
    {
      "text": "The moderating effect was not significant for any other tract.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 11
    },
    {
      "text": "The right SLF I/II FA may reflect individual differences in susceptibility to the cognitive correlates of screen exposure, highlighting the relevance of white matter integrity in understanding the variability in the neurocognitive outcomes associated with screen time.",
      "paperTitle": "White matter integrity buffers the impact of screen time on inhibitory control in youth.",
      "doi": "10.1016/j.dcn.2026.101824",
      "source": "Developmental cognitive neuroscience",
      "yearPublished": 2026,
      "chunk_index_in_doc": 12
    }
