  "10.1080/02701367.2026.2623652": [
    {
      "text": "The objective was to determine the effects of a social network intervention through social support from friends and parents on PA and ST among adolescents. Network mechanisms of perceived social support from friends most associated with PA and ST were explored. Implementing a social support network intervention from friends and parents within physical education classes is effectively increased daily PA and decreased ST among adolescents.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 0
    },
    {
      "text": "Physical activity (PA) and screen time (ST) are complex behaviors influenced by social factors such as relationships with family and friends, linked to mechanisms such as social support.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 1
    },
    {
      "text": "This study implemented a segmentation-based social network intervention which is a promising approach to improving health-behaviors in a network.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "A cluster-randomized controlled trial was conducted involving 4 schools, 24 classrooms, with 787 adolescents.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "A segmentation-based social network intervention was implemented over ten weeks in physical education classes.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
      "text": "Two components, ClassI involving friends support and ParentsI involving parents support was included.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 5
    },
    {
      "text": "Follow-up was conducted at week ten post-intervention.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 6
    },
    {
      "text": "A mixed-effects model was used to determine the effectiveness.",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
      "doi": "10.1080/02701367.2026.2623652",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 7
    },
    {
      "text": "Findings indicated a significant increase of 12.2 daily minutes of PA in the intervention group (95% CI: 1.9 to 22.5, p = .02).",
      "paperTitle": "Social Network Intervention in Physical Education Classes Through Social Support to Promote Physical Activity and Reduce Screen Time in Adolescents: A Cluster Randomized Controlled Trial",
