      "chunk_index_in_doc": 54
    },
    {
      "text": "The TrkB signaling pathway, activated by BDNF binding, initiates downstream cascades supporting synaptic plasticity, neuronal survival, and hippocampal neurogenesis (Ben Ezzdine et al., 2025;Romero Garavito et al., 2025).",
      "paperTitle": "Physical activity, sedentary behavior, and cognitive function in children and adolescents: a scoping review of dose-response relationships, screen time interactions, and public health implications",
      "doi": "10.3389/fnbeh.2026.1848119",
