      "doi": "10.1177/00048674251412123",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 2
    },
    {
      "text": "The search identified 61 eligible studies comprising 338,472 participants aged up to 18 years, drawn from 16 countries.",
      "paperTitle": "Screen time and young people: A systematic review and meta-analysis of the evidence on self-harm and suicidality",
      "doi": "10.1177/00048674251412123",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 3
    },
    {
      "text": "A random-effects meta-analysis of odds ratios was conducted across 15 studies.",
      "paperTitle": "Screen time and young people: A systematic review and meta-analysis of the evidence on self-harm and suicidality",
      "doi": "10.1177/00048674251412123",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 4
    },
    {
