      "chunk_index_in_doc": 117
    },
    {
      "text": "Throughout the data collection window, weekly reminders were sent via WhatsApp and email to encourage participation and address any questions from respondents.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
