      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 79
    },
    {
      "text": "Items were scored on a 5-point Likert scale ranging from “Strongly Disagree” (1) to “Strongly Agree” (5).",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
      "doi": "10.1038/s41598-026-40285-0",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 80
    },
    {
      "text": "Negatively worded items were reverse-coded to ensure consistency in scale interpretation.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
      "doi": "10.1038/s41598-026-40285-0",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 81
    },
    {
      "text": "Students were asked to provide their average scores across multiple continuous assessment components, including quizzes, assignments, class tests, and presentations.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
      "doi": "10.1038/s41598-026-40285-0",
      "source": "openalex",
      "yearPublished": 2026,
      "chunk_index_in_doc": 82
    },
    {
      "text": "To enhance the accuracy of the self-report, students were encouraged to refer to their academic transcripts, printed records, or Learning Management System (LMS) portals when available.",
      "paperTitle": "Mental health and depression as mediators between social media use screen time and academic integrity among tertiary students in Ghana",
